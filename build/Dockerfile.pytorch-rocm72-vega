# EXPERIMENT — DO NOT USE. Froze the host twice, 2026-09-11.
#
# Result: torch 2.11.0+rocm7.2 with the 128 gfx900 rocBLAS files injected passes
# the smoke test and a pointwise-ops test on a freshly booted GPU. But running
# build/pytorch-verify.py (attention, a conv net, a backward pass, fp16/bf16)
# hard-froze the whole machine on BOTH attempts — once with the CPU boost
# overclock enabled, once with it disabled. The same verification passes all 11
# checks on torch 2.7.0+rocm6.3. Use build/Dockerfile.pytorch-rocm63-vega.
#
# Kept rather than deleted so nobody repeats the experiment unknowingly.
#
# Original rationale follows.
#
# Can a newer PyTorch be made to work on gfx900?
#
# torch 2.7.0+rocm6.3 is the last stock wheel shipping gfx900 kernels (128 files
# in torch/lib/rocblas/library/). Every wheel after it — 6.4, 7.0, 7.1, 7.2 —
# ships zero. This image tests whether injecting those kernels into a newer
# wheel is enough, the same trick this repo uses for llama.cpp.
#
# The gate is whether PyTorch's own ATen kernels were compiled for gfx900. If
# they were not, injecting rocBLAS files achieves nothing and this image will
# fail at the first GPU op. That cannot be settled by inspecting the library —
# attempted and it produces false negatives — so it is settled by running.
#
# Source of the kernels: the ROCm 6.3.4 rocBLAS .deb from AMD's apt repo, the
# same place build/build-llamacpp-rocm7-baremetal.sh takes them from. Those
# files are known to work with a 7.2-era rocBLAS -- that is exactly what the
# host install does.
#
# NOT from rocm/dev-ubuntu-22.04:6.3.4. That image carries no
# rocblas/library directory at all today, so the COPY --from approach used in
# build/Dockerfile.rocm7-vega cannot work from a clean cache.
FROM debian:bookworm-slim AS rocm6-libs
ARG ROCBLAS_DEB=https://repo.radeon.com/rocm/apt/6.3.4/pool/main/r/rocblas/rocblas_4.3.0.60304-76~24.04_amd64.deb
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    curl -sL -o /tmp/rocblas.deb "${ROCBLAS_DEB}" && \
    dpkg-deb -x /tmp/rocblas.deb /tmp/x && \
    mkdir -p /gfx900 && \
    find /tmp/x -path '*rocblas/library*' -name '*gfx900*' -exec cp {} /gfx900/ \; && \
    ls /gfx900 | wc -l && test "$(ls /gfx900 | wc -l)" -gt 0

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 libnuma1 && rm -rf /var/lib/apt/lists/*

ARG TORCH_VERSION=2.11.0+rocm7.2
ARG TORCH_INDEX=https://download.pytorch.org/whl/rocm7.2
RUN pip install --no-cache-dir --index-url "${TORCH_INDEX}" "torch==${TORCH_VERSION}" && \
    pip install --no-cache-dir numpy

COPY --from=rocm6-libs /gfx900/ /tmp/rocm6-rocblas/
RUN set -eux; \
    TL="$(python3 -c 'import torch,os;print(os.path.join(os.path.dirname(torch.__file__),"lib","rocblas","library"))')"; \
    echo "target: $TL"; \
    before="$(ls "$TL" | grep -c gfx900 || true)"; \
    find /tmp/rocm6-rocblas -name '*gfx900*' -exec cp {} "$TL/" \; ; \
    after="$(ls "$TL" | grep -c gfx900 || true)"; \
    echo "gfx900 files: $before -> $after"; \
    test "$after" -gt 0; \
    rm -rf /tmp/rocm6-rocblas

ENV HSA_OVERRIDE_GFX_VERSION=9.0.0 \
    HSA_ENABLE_SDMA=0 \
    HSA_XNACK=0

COPY build/pytorch-verify.py /opt/pytorch-verify.py
COPY build/pytorch-smoke.py /opt/pytorch-smoke.py
ENTRYPOINT ["python3", "/opt/pytorch-smoke.py"]
